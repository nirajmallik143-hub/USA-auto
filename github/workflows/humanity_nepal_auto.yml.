`yaml
name: 7G_Autonomous_Pilot
on:
schedule:
- cron: '0 /4 ' # Every 4 hours, I wake up and work
workflow_dispatch:
jobs:
auto_pilot:
runs-on: ubuntu-latest
steps:
- uses: actions/checkout@v3
- name: Setup
run: sudo apt-get update && sudo apt-get install -y ffmpeg && pip install -r requirements.txt
- name: Execute_Mallik_Architecture
env:
YOUTUBE_CLIENT_SECRETS_JSON: ${{ secrets.YOUTUBE_CLIENT_SECRETS_JSON }}
YOUTUBE_TOKEN_JSON: ${{ secrets.YOUTUBE_TOKEN_JSON }}
DRY_RUN_UPLOAD: false # Set to true first if you want to test
run: python -m src.cli run-daily
`

