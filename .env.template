# YouTube API Credentials
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_CREDENTIALS_FILE=credentials.json

# AI Script Generation & Video Options
# Supported: "mock" (default, free offline), "openai" (requires API key)
AI_PROVIDER=mock
OPENAI_API_KEY=your_openai_api_key_here

# Text-to-Speech Options
# Supported: "gtts" (default, free), "openai" (requires API key)
TTS_PROVIDER=gtts

# Asset Stock APIs (Optional for background footage)
PEXELS_API_KEY=your_pexels_api_key_here

# General Settings
OUTPUT_DIR=output
ASSETS_DIR=assets
LOG_LEVEL=INFO
