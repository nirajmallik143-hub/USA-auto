# ==============================================================================
# Automated Video Production & YouTube Upload Pipeline - Configuration Template
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development
LOG_LEVEL=INFO
LOG_TO_FILE=true
LOG_DIR=logs

# ------------------------------------------------------------------------------
# 1. Content Generation (LLM Configuration)
# ------------------------------------------------------------------------------
# Provider options: "openai", "anthropic", "template" (alias: "procedural"; offline/kid-rule fallback)
LLM_PROVIDER=template
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ------------------------------------------------------------------------------
# 2. Voiceover & Audio Engine (TTS)
# ------------------------------------------------------------------------------
# Options: "elevenlabs" or "gtts" (Google TTS is free and requires no API key)
# (TTS_PROVIDER is accepted as an alias of TTS_ENGINE)
TTS_ENGINE=gtts
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
# Kid-friendly American voices (e.g., 21m00Tcm4TlvDq8ikWAM for Rachel, or a custom storyteller)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL_ID=eleven_monolingual_v1

# ------------------------------------------------------------------------------
# 3. Stock Media & Visual Assets
# ------------------------------------------------------------------------------
# Optional stock video/image APIs for kids' visuals (falls back to procedural animations)
PEXELS_API_KEY=your_pexels_api_key_here
PIXABAY_API_KEY=your_pixabay_api_key_here

# ------------------------------------------------------------------------------
# 4. YouTube API Integration & COPPA Compliance
# ------------------------------------------------------------------------------
# Set to false to really upload to YouTube (DRY_RUN_UPLOAD is accepted as an alias)
YOUTUBE_DRY_RUN=true
YOUTUBE_CLIENT_SECRETS_FILE=secrets/client_secrets.json
# OAuth token created by `python -m src.cli auth` (never commit it)
YOUTUBE_CREDENTIALS_FILE=secrets/youtube_credentials.json
# CI only: raw JSON contents written to the two files above by scripts/write_credentials.py
YOUTUBE_CLIENT_SECRETS_JSON=
YOUTUBE_TOKEN_JSON=
# Privacy options: "public", "private", "unlisted", "scheduled"
YOUTUBE_PRIVACY_STATUS=scheduled
# Mandatory COPPA Kids Flag (ALWAYS TRUE FOR KIDS CONTENT)
# (COPPA_MADE_FOR_KIDS is accepted as an alias)
YOUTUBE_MADE_FOR_KIDS=true
# Default category ID: 27 for Education, 24 for Entertainment
YOUTUBE_CATEGORY_ID=27

# ------------------------------------------------------------------------------
# 5. Scheduling & Daily Quotas
# ------------------------------------------------------------------------------
# Daily production targets (5 Shorts + 2 Long Videos per day)
DAILY_SHORTS_TARGET=5
DAILY_LONG_TARGET=2
TIMEZONE=America/New_York

# State tracking & automated retry configuration
MAX_JOB_RETRIES=3
RETRY_BACKOFF_SECONDS=300
AUTO_RETRY_FAILED=true

# Storage and Database paths
DATABASE_URL=sqlite:///storage/pipeline.db
OUTPUT_DIR=output
STORAGE_DIR=storage
TEMP_DIR=temp

# ------------------------------------------------------------------------------
# 6. Distributed Queue & Worker (Celery / Redis)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 7. Optional failure notifications (GitHub Actions secrets)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
