name: Daily USA Kids Videos
on:
schedule:
# Run daily at 11:00 UTC (Morning batch)
- cron: '0 11 * * *'
# Backup run at 15:00 UTC to pick up any failed slots or quota refreshes
- cron: '0 15 * * *'
workflow_dispatch:
inputs:
video_count:
description: 'Number of videos to process in this run'
required: false
default: '7'
type: string
dry_run:
description: 'Run with YouTube upload dry-run enabled'
required: false
default: false
type: boolean
concurrency:
group: daily-videos
cancel-in-progress: false
jobs:
run-pipeline:
runs-on: ubuntu-latest
steps:
- name: Checkout Repository
uses: actions/checkout@v4
- name: Set up Python 3.11
uses: actions/setup-python@v5
with:
python-version: '3.11'
cache: 'pip'
- name: Install System Dependencies (FFmpeg & Fonts)
run: |
sudo apt-get update
sudo apt-get install -y ffmpeg fonts-dejavu-core
- name: Install Python Dependencies
run: |
python -m pip install --upgrade pip
pip install -r requirements.txt
- name: Restore Pipeline State (SQLite DB)
uses: actions/cache@v4
with:
path: output/pipeline.db
key: pipeline-db-${{ github.run_id }}
restore-keys: |
pipeline-db-
- name: Configure Credentials & Environment
env:
YOUTUBE_CLIENT_SECRETS_JSON: ${{ secrets.YOUTUBE_CLIENT_SECRETS_JSON }}
YOUTUBE_TOKEN_JSON: ${{ secrets.YOUTUBE_TOKEN_JSON }}
run: |
mkdir -p secrets output
# Write client secrets if provided
if [ -n "$YOUTUBE_CLIENT_SECRETS_JSON" ]; then
echo "$YOUTUBE_CLIENT_SECRETS_JSON" > secrets/client_secrets.json
fi
# Write OAuth token JSON if provided
if [ -n "$YOUTUBE_TOKEN_JSON" ]; then
echo "$YOUTUBE_TOKEN_JSON" > secrets/youtube_credentials.json
fi
- name: Run System Diagnostics (Doctor)
env:
OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
PEXELS_API_KEY: ${{ secrets.PEXELS_API_KEY }}
LLM_PROVIDER: ${{ vars.LLM_PROVIDER || 'procedural' }}
run: |
python -m src.cli doctor
- name: Execute Daily Video Generation & Upload
env:
OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
ANTHROPIC_API_KEY: ${{ secrets.ANTHROPIC_API_KEY }}
ELEVENLABS_API_KEY: ${{ secrets.ELEVENLABS_API_KEY }}
PEXELS_API_KEY: ${{ secrets.PEXELS_API_KEY }}
LLM_PROVIDER: ${{ vars.LLM_PROVIDER || 'procedural' }}
YOUTUBE_DRY_RUN: ${{ inputs.dry_run == true && 'true' || 'false' }}
COPPA_MADE_FOR_KIDS: 'true'
run: |
python -m src.cli run-daily
- name: Run Retry Pass for Failed Slots
continue-on-error: true
env:
OPENAI_API_KEY: ${{ secrets.OPENAI_API_KEY }}
YOUTUBE_DRY_RUN: ${{ inputs.dry_run == true && 'true' || 'false' }}
run: |
python -m src.cli retry
- name: Verify Pipeline Status
id: status_check
continue-on-error: true
run: |
python -m src.cli status --check
- name: Save Pipeline State (SQLite DB Cache)
uses: actions/cache/save@v4
with:
path: output/pipeline.db
key: pipeline-db-{{ github.run_id }}-{{ github.run_attempt }}
- name: Notify on Failure
if: failure() && github.event_name == 'schedule'
env:
TELEGRAM_BOT_TOKEN: ${{ secrets.TELEGRAM_BOT_TOKEN }}
TELEGRAM_CHAT_ID: ${{ secrets.TELEGRAM_CHAT_ID }}
run: |
if [ -n "TELEGRAM_BOT_TOKEN" ] && [ -n "$TELEGRAM_CHAT_ID" ]; then
curl -s -X POST "https://api.telegram.org/bot${TELEGRAM_BOT_TOKEN}/sendMessage" \
-d chat_id="{TELEGRAM_CHAT_ID}" 
-d text="🚨 USA Kids Pipeline Failure!\nDaily automated run failed on repository ${{ github.repository }}. Check GitHub Actions logs." 
-d parse_mode="Markdown"
else
echo "Telegram credentials not configured; skipping notification."
fi
