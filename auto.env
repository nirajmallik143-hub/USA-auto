==============================================================================
USA KIDS AUTOMATED VIDEO PRODUCTION & YOUTUBE PIPELINE - ENVIRONMENT CONFIG
==============================================================================

1. Application & Logging
APP_ENV=development
LOG_LEVEL=INFO
LOG_TO_FILE=true

2. Content Generation & LLM Settings
# Options: "openai", "anthropic", "template" (offline/kid-rule fallback)
LLM_PROVIDER=openai
OPENAI_API_KEY=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
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=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
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

3. Voiceover & Audio Engine (TTS)
# Options: "elevenlabs" or "gtts" (Google TTS is free and requires no API key)
TTS_ENGINE=elevenlabs
ELEVENLABS_API_KEY=sk_4a3611806fae9ee0c5a02e356c933c4b091667cc637d6aef
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEvenLABS_MODEL_ID=eleven_monolingual_v1

4. Stock Media & Visual Assets
# Optional stock video/image APIs for kids' visuals (falls back to procedural animations)
PEXELS_API_KEY=
PIXABAY_API_KEY=57822629-4f197bbf16c8182521252a2f3

5. YouTube API Integration & COPPA Compliance
# Set to true to test the full pipeline without actually uploading to YouTube
YOUTUBE_DRY_RUN=true
YOUTUBE_CLIENT_SECRETS_FILE=secrets/client_secrets.json
YOUTUBE_CREDENTIALS_FILE=secrets/youtube_credentials.json

# Privacy options: "public", "private", "unlisted", "scheduled"
YOUTUBE_PRIVACY_STATUS=scheduled

# Mandatory COPPA Kids Flag (ALWAYS TRUE FOR KIDS CONTENT)
YOUTUBE_MADE_FOR_KIDS=true

# Default category ID: 27 for Education, 24 for Entertainment
YOUTUBE_CATEGORY_ID=27

6. Scheduling & Daily Quotas
# Daily production targets (5 Shorts + 2 Long Videos per day)
DAILY_SHORTS_TARGET=5
DAILY_LONG_TARGET=2
TIMEZONE=America/New_York

# State tracking & automated retry configuration
MAX_JOB_RETRIES=3
RETRY_BACKOFF_SECONDS=300
AUTO_RETRY_FAILED=true

# Storage and Database paths
DATABASE_URL=sqlite:///storage/pipeline.db
OUTPUT_DIR=output
STORAGE_DIR=storage
TEMP_DIR=temp

7. Distributed Queue & Worker (Celery / Redis)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0